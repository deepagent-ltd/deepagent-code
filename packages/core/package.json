    "@ai-sdk/provider": "catalog:",
    "@ai-sdk/provider-utils": "catalog:",
    "@ai-sdk/togetherai": "2.0.41",
    "@ai-sdk/vercel": "2.0.39",
    "@ai-sdk/xai": "3.0.82",
    "@aws-sdk/credential-providers": "3.1057.0",
    "@deepagent-code/effect-drizzle-sqlite": "workspace:*",
    "@deepagent-code/effect-sqlite-node": "workspace:*",
    "@deepagent-code/llm": "workspace:*",
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@ff-labs/fff-bun": "0.10.6",
    "@lydell/node-pty": "catalog:",
    "@npmcli/arborist": "9.4.0",
    "@npmcli/config": "10.8.1",
    "@openrouter/ai-sdk-provider": "2.9.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.6.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.214.0",
    "@opentelemetry/sdk-trace-base": "2.6.1",
    "@parcel/watcher": "2.5.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "ai-gateway-provider": "3.1.2",
    "ajv": "8.20.0",
    "bun-pty": "0.4.8",
    "cross-spawn": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "fuzzysort": "3.1.0",
    "gitlab-ai-provider": "6.8.0",
    "glob": "13.0.5",
