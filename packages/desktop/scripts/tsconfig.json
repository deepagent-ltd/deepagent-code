{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "isolatedModules": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.ts-dist",
    "types": ["bun", "node"]
  },
  "include": ["*.ts", "../../deepagent-code/src/installation/native-installation.schema.ts", "../../deepagent-code/script/sign-native-node.ts", "../../deepagent-code/script/sign-windows-native-cli.ts", "../../deepagent-code/script/build-linux-native-assets.ts", "../../deepagent-code/script/build-work-file-helper.ts", "../../deepagent-code/script/build-work-storage-cleanup.ts", "../../deepagent-code/script/build-windows-native-bootstrap.ts"],
  "exclude": ["live-llm/**", "subagents-live.ts"]
}
